{
  "name": "lockdown-quiz",
  "version": "1.0.0",
  "description": "Lockdown Browser Quiz Platform",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win"
  },
  "build": {
    "appId": "com.quiz.lockdown",
    "productName": "LockDownBrowser.",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "icon.png",
      "icon.ico"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "icon": "icon.png"
    },
    "win": {
      "target": "portable",
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "LockDownBrowser.-${version}.${ext}"
    },
    "dmg": {
      "title": "LockDown Quiz",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
